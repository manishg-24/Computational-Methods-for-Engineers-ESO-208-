import numpy as np

def cholesky_factor(matrix):
    size = len(matrix)
    lower = np.zeros((size, size))

    for i in range(size):
        for j in range(i + 1):
            total = np.dot(lower[i][:j], lower[j][:j])

            if i == j:
                lower[i][j] = np.sqrt(matrix[i][i] - total)
            else:
                lower[i][j] = (matrix[i][j] - total) / lower[j][j]

    return lower


matrix = np.array([
    [8, 20, 15],
    [20, 80, 50],
    [15, 50, 60]
], dtype=float)

lower = cholesky_factor(matrix)

print("L =\n", lower)
print("Check L @ L.T =\n", lower @ lower.T)
