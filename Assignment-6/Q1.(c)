import numpy as np

A = np.zeros((15, 15))
B = np.zeros(15)

A[0, 0] = 1.0
B[0] = 0.0

A[1, 0:3] = [0.0, 0.0, 1.0]; B[1] = 14.621
A[2, 0:3] = [64.0, 8.0, 1.0]; B[2] = 11.843

A[3, 3:6] = [64.0, 8.0, 1.0]; B[3] = 11.843
A[4, 3:6] = [256.0, 16.0, 1.0]; B[4] = 9.870

A[5, 6:9] = [256.0, 16.0, 1.0]; B[5] = 9.870
A[6, 6:9] = [576.0, 24.0, 1.0]; B[6] = 8.418

A[7, 9:12] = [576.0, 24.0, 1.0]; B[7] = 8.418
A[8, 9:12] = [1024.0, 32.0, 1.0]; B[8] = 7.305

A[9, 12:15] = [1024.0, 32.0, 1.0]; B[9] = 7.305
A[10, 12:15] = [1600.0, 40.0, 1.0]; B[10] = 6.413

A[11, [0, 1, 3, 4]] = [16.0, 1.0, -16.0, -1.0]; B[11] = 0.0

A[12, [3, 4, 6, 7]] = [32.0, 1.0, -32.0, -1.0]; B[12] = 0.0

A[13, [6, 7, 9, 10]] = [48.0, 1.0, -48.0, -1.0]; B[13] = 0.0

A[14, [9, 10, 12, 13]] = [64.0, 1.0, -64.0, -1.0]; B[14] = 0.0


M = np.hstack([A, B.reshape(-1, 1)])
n = 15

for i in range(n):
    max_row = i + np.argmax(np.abs(M[i:, i]))
    if max_row != i:
        M[[i, max_row]] = M[[max_row, i]]
    for j in range(i + 1, n):
        factor = M[j, i] / M[i, i]
        M[j, i:] -= factor * M[i, i:]
x = np.zeros(n)
for i in range(n - 1, -1, -1):
    x[i] = (M[i, -1] - np.dot(M[i, i + 1 : n], x[i + 1 : n])) / M[i, i]

intervals = [(0, 8), (8, 16), (16, 24), (24, 32), (32, 40)]
for i in range(5):
    a_val, b_val, c_val = x[3 * i], x[3 * i + 1], x[3 * i + 2]
    print(
        f"Interval {intervals[i]}: s_{i+1}(T) = ({a_val:.3f})*T^2 + ({b_val:.3f})*T + ({c_val:.3f})"
    )
