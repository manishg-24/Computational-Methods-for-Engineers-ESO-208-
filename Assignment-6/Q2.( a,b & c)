rows = [line.split() for line in data_text.strip().split("\n")]
years = np.array([int(r[0]) for r in rows])
Q = np.array([float(r[1]) for r in rows])
N = len(Q)
T = 114.0
t = np.arange(1, N + 1)

a0 = np.sum(Q) / N
nmax = N // 2
a = np.zeros(nmax + 1)
b = np.zeros(nmax + 1)
for n in range(1, nmax + 1):
    a[n] = (2.0 / N) * np.sum(Q * np.cos(2 * np.pi * n * t / T))
    b[n] = (2.0 / N) * np.sum(Q * np.sin(2 * np.pi * n * t / T))

power = a**2 + b**2
freq  = np.arange(0, nmax + 1) / T

order = np.argsort(power[1:])[::-1] + 1
top3 = order[:3]
print("Rank   n     freq(cyc/yr)   period(yr)      power")
for k, n in enumerate(top3, 1):
    print(f"{k:>3}  {n:>4}   {freq[n]:>10.5f}   {T/n:>9.3f}   {power[n]:>12.3e}")

plt.figure(figsize=(8, 5))
plt.plot(freq[1:], power[1:], '-o', ms=3, lw=1)
plt.scatter(freq[top3], power[top3], color='red', zorder=5, label='3 dominant frequencies')
plt.xlabel('Frequency (cycles/year)')
plt.ylabel('Power  $(a_n^2+b_n^2)$')
plt.title('Power spectrum of annual river flow (1906–2019)')
plt.legend()
plt.tight_layout()
plt.savefig('power_spectrum.png', dpi=150)

with open('coefficients.csv', 'w') as f:
