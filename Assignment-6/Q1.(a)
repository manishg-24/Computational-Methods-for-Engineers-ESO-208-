import numpy as np

T = np.array([0, 8, 16, 24, 32, 40], dtype=float)
O = np.array([14.621, 11.843, 9.870, 8.418, 7.305, 6.413], dtype=float)

n = len(T)

def divided_differences(x, y):
    F = np.zeros((n, n))
    F[:, 0] = y
    for j in range(1, n):
        for i in range(n - j):
            F[i, j] = (F[i + 1, j - 1] - F[i, j - 1]) / (x[i + j] - x[i])
    return F

F = divided_differences(T, O)
coeffs = F[0, :]    
for i, c in enumerate(coeffs):
    print(f"  a{i} = {c:.11f}")

def newton_poly(x_eval, x=T, b=coeffs):
    x_eval = np.atleast_1d(x_eval).astype(float)
    result = np.full_like(x_eval, b[0])
    prod = np.ones_like(x_eval)
    for k in range(1, n):
        prod *= (x_eval - x[k - 1])
        result += b[k] * prod
    return result
