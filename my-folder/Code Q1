import numpy as np

def lu_factorization(matrix):
    n = len(matrix)
    upper = matrix.astype(float).copy()
    lower = np.eye(n)

    for k in range(n - 1):
        for i in range(k + 1, n):
            lower[i][k] = upper[i][k] / upper[k][k]
            upper[i][k:] = upper[i][k:] - lower[i][k] * upper[k][k:]

    return lower, upper


def forward_solve(lower, rhs):
    n = len(rhs)
    y = np.zeros(n)

    for i in range(n):
        y[i] = rhs[i] - np.dot(lower[i][:i], y[:i])

    return y


def backward_solve(upper, y):
    n = len(y)
    solution = np.zeros(n)

    for i in range(n - 1, -1, -1):
        solution[i] = (
            y[i] - np.dot(upper[i][i + 1:], solution[i + 1:])
        ) / upper[i][i]

    return solution


def solve_lu(lower, upper, rhs):
    intermediate = forward_solve(lower, rhs)
    return backward_solve(upper, intermediate)


def find_inverse(lower, upper):
    n = len(lower)
    inverse_matrix = np.zeros((n, n))

    for col in range(n):
        unit_vector = np.zeros(n)
        unit_vector[col] = 1.0
        inverse_matrix[:, col] = solve_lu(lower, upper, unit_vector)

    return inverse_matrix


def row_norm(matrix):
    return max(sum(abs(value) for value in row) for row in matrix)


matrix = np.array([
    [7, 2, -3],
    [2, 5, -3],
    [1, -1, -6]
], dtype=float)

rhs = np.array([12, 18, -6], dtype=float)

lower, upper = lu_factorization(matrix)
solution = solve_lu(lower, upper, rhs)

inverse_matrix = find_inverse(lower, upper)

condition_number = row_norm(matrix) * row_norm(inverse_matrix)

print("L =\n", lower)
print("U =\n", upper)
print("X =", solution)
print("A_inv =\n", inverse_matrix)
print("cond(A) =", condition_number)
