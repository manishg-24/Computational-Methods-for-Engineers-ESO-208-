import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

K = 0.49
h = 10.0
N = 5

def known(i, j):
    if j == N-1: return 25.0*i
    if i == N-1: return 25.0*j
    return None

n = N-1
idx = lambda i, j: j*n + i
A = np.zeros((n*n, n*n)); b = np.zeros(n*n)

for j in range(n):
    for i in range(n):
        r = idx(i, j)
        A[r, r] = -4.0
        for di in (-1, 1):
            ii = i + di
            if ii < 0:
                A[r, idx(1, j)] += 1.0
            elif ii > n-1:
                b[r] -= known(ii, j)
            else:
                A[r, idx(ii, j)] += 1.0
        for dj in (-1, 1):
            jj = j + dj
            if jj < 0:
                A[r, idx(i, 1)] += 1.0
            elif jj > n-1:
                b[r] -= known(i, jj)
            else:
                A[r, idx(i, jj)] += 1.0

def gauss(A, b):
    A = A.astype(float).copy(); b = b.astype(float).copy(); m = len(b)
    for k in range(m-1):
        p = np.argmax(abs(A[k:, k])) + k
        if p != k:
            A[[k, p]] = A[[p, k]]; b[[k, p]] = b[[p, k]]
        for r in range(k+1, m):
            f = A[r, k]/A[k, k]
            A[r, k:] -= f*A[k, k:]; b[r] -= f*b[k]
    x = np.zeros(m)
    for r in range(m-1, -1, -1):
        x[r] = (b[r] - A[r, r+1:] @ x[r+1:])/A[r, r]
    return x

T_unk = gauss(A, b)

T = np.zeros((N, N))
for j in range(N):
    for i in range(N):
        T[j, i] = known(i, j) if known(i, j) is not None else T_unk[idx(i, j)]
print("Temperature field (rows: y=40 at top ... y=0 at bottom)")
print(np.flipud(np.round(T, 3)))

qx = np.zeros((N, N)); qy = np.zeros((N, N))
for j in range(N):
    for i in range(N):
        Tl = T[j, i-1] if i > 0 else T[j, i+1]
        Tr = T[j, i+1] if i < N-1 else None
        Td = T[j-1, i] if j > 0 else T[j+1, i]
        Tu = T[j+1, i] if j < N-1 else None
        if Tr is None: qx[j, i] = -K*(T[j, i]-T[j, i-1])/h
        else:          qx[j, i] = -K*(Tr-Tl)/(2*h)
        if Tu is None: qy[j, i] = -K*(T[j, i]-T[j-1, i])/h
        else:          qy[j, i] = -K*(Tu-Td)/(2*h)
qmag = np.hypot(qx, qy)
print("\nHeat flux magnitude (cal/s/cm^2), same orientation")
print(np.flipud(np.round(qmag, 4)))

x = np.arange(N)*h; X, Y = np.meshgrid(x, x)
fig, ax = plt.subplots(1, 2, figsize=(12, 5))
c = ax[0].contourf(X, Y, T, 20, cmap="hot"); fig.colorbar(c, ax=ax[0], label="T (°C)")
ax[0].contour(X, Y, T, 10, colors="k", linewidths=0.4)
ax[0].plot(X, Y, "k.", ms=3); ax[0].set_title("Temperature profile"); ax[0].set_xlabel("x (cm)"); ax[0].set_ylabel("y (cm)")
c2 = ax[1].contourf(X, Y, qmag, 20, cmap="viridis"); fig.colorbar(c2, ax=ax[1], label="|q| (cal/s·cm²)")
ax[1].quiver(X, Y, qx, qy, color="w"); ax[1].set_title("Heat flux (vectors, magnitude)")
ax[1].set_xlabel("x (cm)"); ax[1].set_ylabel("y (cm)")
plt.tight_layout(); plt.savefig("q1_plots.png", dpi=150)
