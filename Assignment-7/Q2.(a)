import numpy as np
Q=lambda t: 8+5*np.cos(0.4*t)**2
c=lambda t: 5*np.exp(-0.5*t)+3*np.exp(0.15*t)
f=lambda t: Q(t)*c(t)
a,b=2.,8.; tol=0.1*100 
R=[[0.5*(b-a)*(f(a)+f(b))]]; print("k=1  R11=%.6f"%R[0][0])
k=1
while True:
    k+=1; n=2**(k-2); h=(b-a)/n
    s=sum(f(a+(2*i-1)*h/2) for i in range(1,n+1))
    row=[0.5*(R[-1][0]+h*s)]
    for j in range(2,k+1):
        row.append(row[j-2]+(row[j-2]-R[-1][j-2])/(4**(j-1)-1))
    R.append(row)
    ea=abs((row[-1]-R[-2][-1])/row[-1])*100
    print(f"k={k} "+"  ".join(f"{v:.6f}" for v in row)+f"   |ea|={ea:.5f}%")
    if ea<tol: break
print("M = %.4f mg"%row[-1])
