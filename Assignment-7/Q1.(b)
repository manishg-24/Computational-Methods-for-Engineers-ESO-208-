import numpy as np

y = np.array([0, 2, 4, 6, 8, 10, 12, 14])
H = np.array([0, 1, 1.5, 3, 3.5, 3.2, 2, 0])
U = np.array([0, 0.1, 0.12, 0.2, 0.25, 0.3, 0.15, 0])

HU = H * U
h = y[1] - y[0]

A_13 = (h / 3.0) * (H[0] + 4 * (H[1] + H[3]) + 2 * H[2] + H[4])
Q_13 = (h / 3.0) * (HU[0] + 4 * (HU[1] + HU[3]) + 2 * HU[2] + HU[4])

A_38 = (3 * h / 8.0) * (H[4] + 3 * (H[5] + H[6]) + H[7])
Q_38 = (3 * h / 8.0) * (HU[4] + 3 * (HU[5] + HU[6]) + HU[7])

A_simp = A_13 + A_38
Q_simp = Q_13 + Q_38
U_avg_simp = Q_simp / A_simp

print(f"Area (A)              : {A_simp:.2f} m^2")
print(f"Discharge (Q)         : {Q_simp:.2f} m^3/s")
print(f"Average Velocity (U)  : {U_avg_simp:.2f} m/s")
