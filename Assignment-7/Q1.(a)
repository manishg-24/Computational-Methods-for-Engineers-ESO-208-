import numpy as np

y = np.array([0, 2, 4, 6, 8, 10, 12, 14])
H = np.array([0, 1, 1.5, 3, 3.5, 3.2, 2, 0])
U = np.array([0, 0.1, 0.12, 0.2, 0.25, 0.3, 0.15, 0])

HU = H * U
h = y[1] - y[0]

A_trap = (h / 2.0) * (H[0] + 2 * np.sum(H[1:-1]) + H[-1])
Q_trap = (h / 2.0) * (HU[0] + 2 * np.sum(HU[1:-1]) + HU[-1])
U_avg_trap = Q_trap / A_trap

print(f"Area (A)              : {A_trap:.2f} m^2")
print(f"Discharge (Q)         : {Q_trap:.2f} m^3/s")
print(f"Average Velocity (U)  : {U_avg_trap:.2f} m/s")
