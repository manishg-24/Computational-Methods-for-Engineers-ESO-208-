import numpy as np
import matplotlib.pyplot as plt

T = 10.0
# Avoid exact multiples of T/2 to prevent division by zero errors
t = np.linspace(1e-5, T - 1e-5, 500) 

kappa = np.abs((2 * np.pi * t / T) / np.tan(2 * np.pi * t / T))

plt.plot(t, kappa, color="b")
plt.xlabel("Time (t)")
plt.ylabel("Condition Number")
plt.grid(True)
plt.show()
